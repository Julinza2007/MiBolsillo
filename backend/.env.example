# Puerto del servidor
PORT=3000

# Conexión PostgreSQL (Neon)
DATABASE_URL=

# Clave privada para firmar sesiones. Generá una propia de al menos 32 caracteres.
JWT_SECRET=

# URL pública del frontend para habilitar CORS en producción
FRONTEND_URL=http://localhost:5173

# Límite del pool de conexiones PostgreSQL
DB_POOL_MAX=5
